// ============================================================================
// dsh-deskpet 用户层默认配置（JSONC：允许 // 与 /* */ 注释）
// ============================================================================
// 优先级：用户层 $DSH_HOME/dsh-deskpet/main-config.jsonc 覆盖本文件；
//         本文件里没写的字段静默取代码内置默认（见 runtime/electron-helper/config.js）。
//
// 设计取向（与 dsh-pet 不同的地方）：
//   本插件只服务「DSH 桌面客户端 + 宠物住在 Windows 桌面上」这一种形态，
//   所以没有 display/display=web 那套四值开关——宠物永远只在桌面窗口里。
// ============================================================================
{
  // ===================== 宠物实例列表（多开） =====================
  "pets": [
    {
      // id：唯一标识（素材 / 记忆 / 端点参数都按它定位）。必填，全局唯一。
      "id": "main",
      // name：显示名，也会进 AI 人设（「你的名字是X」）。可重复。
      "name": "阿狐",
      // species：形象 = assets/pet/species.json 里的 id（foxboy / policegirl…）
      //          右键「切换形象」即时换皮，换完会写回用户配置。
      "species": "foxboy",
      // size：宠物宽度（CSS px / DIP）。高度 = size × 形象高宽比（由清单给出）
      "size": 190,
      // 初始停靠：四角之一 + 距角落的边距（px）
      "position": {
        "corner": "bottom-right",
        "marginX": 24,
        "marginY": 24
      }
    }
  ],

  // ===================== 行为开关 =====================
  // 屏幕漫游：没事的时候自己在桌面上溜达
  "roamEnabled": true,
  "roam": {
    "minDist": 80,        // 单次移动距离下限（px）
    "maxDist": 260,       // 上限
    "speed": 70,          // 行走速度（px/s）
    "pauseMinSec": 8,     // 两次漫游之间的最短发呆时间
    "pauseMaxSec": 22     // 最长发呆时间
  },

  // 工作状态联动：监听 DSH 会话事件（思考/干活/等你确认/完成/出错）切动画 + 气泡
  "workStatusEnabled": true,

  // 提醒：DSH 干完活 / 要你确认 / 出错时，用宠物气泡告诉你
  "notifyEnabled": true,
  // 额外弹 Windows 系统通知（**只在 DSH 不在前台时**弹，你正看着 DSH 就不打扰）
  "notifySystemToast": true,

  // 点击宠物：唤起并聚焦 DeepSeek Harness 窗口
  "clickToFocusDsh": true,

  // ===================== 拖拽抛掷物理 =====================
  "physics": {
    "gravity": 2400,        // px/s²（0 = 无重力漂浮）
    "restitution": 0.55,    // 碰壁恢复系数 0~1
    "groundFriction": 3.4,  // 落地水平摩擦（/s）
    "throwPower": 1.0       // 总力度增益，必须 > 0
  },

  // ===================== 工作状态文案（索引 = 档位，勿在中间插档） =====================
  // 0 thinking / 1 working / 2 result / 3 waiting / 4 success / 5 error
  "workStatusTexts": [
    ["正在想呢…"],
    ["正在干活，别打扰我～"],
    ["搞定一步，继续～"],
    ["轮到你来决定啦，等你～"],
    ["这一轮搞定啦！"],
    ["好像卡住了呢…"]
  ]
}
